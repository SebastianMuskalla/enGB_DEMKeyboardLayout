<?xml version="1.1" encoding="UTF-8"?>
<!DOCTYPE keyboard SYSTEM "file://localhost/System/Library/DTDs/KeyboardLayout.dtd">
<!--
  United Kingdom plus German and Math

  macOS port of enGB_DEM.klc / xkb/symbols/enGB_DEM. Intended for ISO (105-key) keyboards.
  Layers: Base, Shift, Option (= AltGr), Option+Shift (= AltGr+Shift).
  Control and Command never change the produced character.
-->
<keyboard group="126" id="-24671" name="United Kingdom plus German and Math" maxout="1">
    <layouts>
        <layout first="0" last="255" mapSet="default" modifiers="modifiers"/>
    </layouts>
    <modifierMap id="modifiers" defaultIndex="0">
        <keyMapSelect mapIndex="0">
            <modifier keys="command? anyControl?"/>
        </keyMapSelect>
        <keyMapSelect mapIndex="1">
            <modifier keys="anyShift caps? command? anyControl?"/>
        </keyMapSelect>
        <keyMapSelect mapIndex="2">
            <modifier keys="caps command? anyControl?"/>
        </keyMapSelect>
        <keyMapSelect mapIndex="3">
            <modifier keys="anyOption command? anyControl?"/>
        </keyMapSelect>
        <keyMapSelect mapIndex="4">
            <modifier keys="anyShift anyOption caps? command? anyControl?"/>
        </keyMapSelect>
        <keyMapSelect mapIndex="5">
            <modifier keys="caps anyOption command? anyControl?"/>
        </keyMapSelect>
    </modifierMap>
